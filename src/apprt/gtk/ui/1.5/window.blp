using Gtk 4.0;
using Adw 1;

template $GhosttyWindow: Adw.ApplicationWindow {
  styles ["window", "colm-window"]
  close-request => $close_request();
  realize => $realize();
  notify::config => $notify_config();
  notify::fullscreened => $notify_fullscreened();
  notify::is-active => $notify_is_active();
  notify::maximized => $notify_maximized();
  notify::quick-terminal => $notify_quick_terminal();
  notify::scale-factor => $notify_scale_factor();
  default-width: 1280;
  default-height: 800;
  handle-menubar-accel: false;

  content: Gtk.Overlay {
    Adw.OverlaySplitView {
      min-sidebar-width: 200;
      max-sidebar-width: 300;
      sidebar-width-fraction: 0.19;

      sidebar: Adw.ToolbarView {
        styles ["colm-sidebar"]
        [top]
        Adw.HeaderBar {
          show-start-title-buttons: false;
          show-end-title-buttons: false;
          title-widget: Gtk.Box {};
          [start]
          Gtk.Button {
            icon-name: "list-add-symbolic";
            action-name: "win.new-tab";
            tooltip-text: _("New workspace");
            styles ["flat"]
          }
          [end]
          Gtk.Box {
            spacing: 2;
            Gtk.Button {
              icon-name: "view-grid-symbolic";
              action-name: "win.toggle-column-overview";
              tooltip-text: _("Column overview");
              styles ["flat"]
            }
            Gtk.MenuButton {
              icon-name: "view-more-symbolic";
              menu-model: workspace_menu;
              tooltip-text: _("Workspace menu");
              styles ["flat"]
            }
          }
        }

        Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;
          overlay-scrolling: true;
          vexpand: true;
          Gtk.GestureClick {
            button: 1;
            propagation-phase: capture;
            pressed => $workspace_background_pressed();
          }
          Gtk.ListBox workspace_list {
            margin-top: 2;
            styles ["navigation-sidebar", "workspace-list"]
            selection-mode: single;
            activate-on-single-click: true;
            row-selected => $workspace_selected();
          }
        }
      };

      content: Adw.OverlaySplitView right_sidebar {
        sidebar-position: end;
        min-sidebar-width: 260;
        max-sidebar-width: 360;
        sidebar-width-fraction: 0.24;
        collapsed: true;
        pin-sidebar: false;
        show-sidebar: false;

        sidebar: Adw.ToolbarView right_sidebar_panel {
          styles ["colm-sidebar"]
          [top]
          Adw.HeaderBar {
            show-start-title-buttons: false;
            show-end-title-buttons: false;
            title-widget: Gtk.Label right_sidebar_title {
              label: _("Activity");
              styles ["heading"]
            };
            [end]
            Gtk.Button {
              icon-name: "window-close-symbolic";
              action-name: "win.hide-right-sidebar";
              tooltip-text: _("Close sidebar");
              styles ["flat"]
            }
          }
          Gtk.ScrolledWindow {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            vexpand: true;
            Gtk.ListBox activity_list {
              margin-top: 8;
              margin-bottom: 8;
              margin-start: 8;
              margin-end: 8;
              selection-mode: none;
              styles ["boxed-list"]
            }
          }
        };

        content: Adw.ToolbarView toolbar {
        top-bar-style: flat;
        [top]
        Adw.HeaderBar {
          visible: bind template.headerbar-visible;
          show-start-title-buttons: false;
          title-widget: Adw.WindowTitle {
            title: bind template.title;
            subtitle: bind $computed_subtitle(template.config, tab_view.selected-page.child as <$GhosttyTab>.active-surface as <$GhosttySurface>.pwd) as <string>;
          };
          [start]
          Gtk.Button {
            icon-name: "list-add-symbolic";
            action-name: "win.split-right";
            tooltip-text: _("New terminal · Ctrl+Shift+T");
            styles ["flat"]
          }
          [end]
          Gtk.Box {
            spacing: 2;
            Gtk.Button {
              icon-name: "preferences-system-notifications-symbolic";
              action-name: "win.show-activity";
              tooltip-text: _("Activity and notifications");
              styles ["flat"]
            }
            Gtk.MenuButton {
              notify::active => $notify_menu_active();
              icon-name: "open-menu-symbolic";
              popover: Gtk.PopoverMenu main_popover {
                menu-model: main_menu;
              };
              tooltip-text: _("Main menu");
            }
          }
        }

        Gtk.Box {
          orientation: vertical;
          $GhosttyDebugWarning { visible: bind template.debug; }
          Adw.ToastOverlay toast_overlay {
            vexpand: true;
            Adw.TabView tab_view {
              notify::n-pages => $notify_n_pages();
              notify::selected-page => $notify_selected_page();
              close-page => $close_page();
              page-attached => $page_attached();
              page-detached => $page_detached();
              create-window => $tab_create_window();
              setup-menu => $setup_tab_menu();
              menu-model: tab_context_menu;
              shortcuts: none;
            }
          }
        }
      };
      };
    }

    [overlay]
    Gtk.Revealer column_overview {
      styles ["column-overview"]
      transition-type: crossfade;
      reveal-child: false;
      visible: false;

      Adw.ToolbarView column_overview_view {
        [top]
        Adw.HeaderBar {
          [start]
          Gtk.ToggleButton column_overview_search_button {
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Search Columns");
          }

          title-widget: Adw.WindowTitle column_overview_title {
            styles ["numeric"]
          };
        }

        [top]
        Gtk.SearchBar column_overview_search_bar {
          search-mode-enabled: bind column_overview_search_button.active bidirectional;
          key-capture-widget: column_overview_view;

          Adw.Clamp {
            hexpand: true;
            maximum-size: 400;

            Gtk.SearchEntry column_overview_search {
              hexpand: true;
              placeholder-text: _("Search columns");
              search-changed => $column_overview_search_changed();
            }
          }
        }

        content: Gtk.Overlay {
          vexpand: true;

          Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            Gtk.FlowBox column_overview_grid {
              valign: start;
              halign: center;
              selection-mode: none;
              activate-on-single-click: true;
              child-activated => $column_overview_child_activated();
              column-spacing: 5;
              row-spacing: 5;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 16;
              margin-end: 16;
              max-children-per-line: 8;
            }
          }

          [overlay]
          Gtk.Button column_overview_new {
            halign: center;
            valign: end;
            clicked => $column_overview_new_clicked();
            styles ["pill", "suggested-action", "new-tab-button"]

            Adw.ButtonContent {
              icon-name: "tab-new-symbolic";
              label: _("New Column");
            }
          }
        };
      }
    }
  };
}

menu main_menu {
  section {
    item { custom: "appearance-scheme"; }
  }
  section {
    item { label: _("New Terminal"); action: "win.split-right"; }
    item { label: _("Close Terminal"); action: "win.close-terminal"; }
    item { label: _("New Workspace"); action: "win.new-tab"; }
    item { label: _("Rename Workspace…"); action: "win.prompt-tab-title"; }
    item { label: _("New Window"); action: "win.new-window"; }
  }
  section {
    item { label: _("Copy"); action: "win.copy"; }
    item { label: _("Paste"); action: "win.paste"; }
    item { label: _("Command Palette"); action: "win.toggle-command-palette"; }
  }
  section {
    item { label: _("Settings…"); action: "win.appearance"; }
    item { label: _("Open Configuration"); action: "app.open-config"; }
    item { label: _("Reload Configuration"); action: "app.reload-config"; }
    item { label: _("About Colm"); action: "win.about"; }
  }
}

menu workspace_menu {
  item { label: _("New Workspace…"); action: "win.new-tab"; }
  item { label: _("Rename Workspace…"); action: "win.prompt-tab-title"; }
  item { label: _("Close Workspace"); action: "win.close-tab"; target: "this"; }
}

menu tab_context_menu {
  item { label: _("Rename Workspace…"); action: "win.prompt-context-tab-title"; }
  item { label: _("Close Workspace"); action: "win.close-tab"; target: "this"; }
}
